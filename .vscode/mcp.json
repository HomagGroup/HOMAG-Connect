{
  "servers": {
    "Document360": {
      "url": "https://mcp.document360.io/mcp",
      "type": "http"
    },
    "azure-devops": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/homag-group"
    },
    "Figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "type": "http"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    }
  }
}